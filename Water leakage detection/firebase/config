function tickFlowSensor() {
  if (!flowChart) return;

  const r1 = +(Math.random() * 10 + 20).toFixed(1); // 20–30
  const r2 = +(Math.random() * 20 + 10).toFixed(1); // 10–30

  const now = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });

  // Slide the window
  if (flowLabels.length >= FLOW_MAX_POINTS) {
    flowLabels.shift();
    flowData1.shift();
    flowData2.shift();
  }

  flowLabels.push(now);
  flowData1.push(r1);
  flowData2.push(r2);

  flowChart.update('none'); // no animation on data push (smooth scroll feel)
  updateFlowSensorUI(r1, r2);
}